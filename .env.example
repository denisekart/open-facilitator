# Local dev environment examples (copy values into your shell or compose env).
# Kernel identity (plan 09): the kernel refuses to boot without these four.
# Dev IdP: docker run -d --name facilitator-idp -p 8480:8080 \
#   -v $PWD/reference/keycloak/realm.json:/opt/keycloak/data/import/realm.json \
#   quay.io/keycloak/keycloak:$(grep '^KEYCLOAK_TAG=' reference/versions.env | cut -d= -f2) \
#   start-dev --import-realm
Identity__Oidc__Authority=http://localhost:8480/realms/facilitator
Identity__Oidc__Audience=facilitator-api
Identity__Oidc__RequireHttps=false
# Identity__Oidc__TrustedIssuers__0=https://accounts.google.com

# Kernel CLI bearer token (required; an OIDC access token for the facilitator-cli client):
FACILITATOR_TOKEN=

# Link enrollment secret (link plane):
Link__EnrollmentToken=enroll-dev
