# OS / editors
.DS_Store
*.swp
.idea/

# Build outputs (once implementation starts)
# 2026-11-02: narrowed from a bare `bin/` — that also matched the TypeScript
# packages' SOURCE entrypoints (src/*/src/bin/*.ts, the tsup bin targets), so
# a clean CI checkout silently lost every gateway/linkd/worker/connector bin
# source and features/build.mjs failed its install-contract assert.
# .NET build output is always bin/{Debug,Release}/.
**/bin/Debug/
**/bin/Release/
**/obj/
dist/
node_modules/
coverage/
TestResults/
# pnpm falls back to a project-local store when the global one is
# unreachable (sandboxed installs); 12k content-addressable files must
# never surface in git status.
.pnpm-store/
.vitest/

# Local environment & generated secrets (spec §22: never commit)
.env
.env.*
!.env.example
secrets/
*.pem
*.jwt

# Example/gateway runtime state (walkthrough-created dirs)
.ofac-gateway/
.ofac-worker/
.ofac-logs/
.ofac-linkd.sqlite3
.ofac-artifacts/

# Generated Feature install payloads (features/build.mjs output)
features/src/*/pkg/
# omp session-local artifacts
.omp/plans/*.local.md

# Embedded SPA build output: vite empties + refills this whole dir (a
# .gitkeep anchor would be wiped every build). Pure output like dist/ — the
# kernel boots fine with no web root (SPA served only after `pnpm -r build`).
src/facilitator/wwwroot/

# CDK synth output (examples/aws): pure build output like dist/.
examples/aws/cdk.out/
# Generated by `deployctl smoke` on every run (deleted on success).
examples/aws/envs/smoke.json
