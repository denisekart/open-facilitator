<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Resolved via `dotnet new xunit` + nuget flat container on 2026-10: -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Plan 21 browser tier (npm/nuget registry, 2026-10). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Plan 01 protocol harness (nuget flat container, 2026-10):
         JsonSchema.Net 9.4.1 (draft 2020-12, RequireFormatValidation),
         Jcs.Net 0.1.1 (RFC 8785; passes the golden + numeric/sort/NFC vectors). -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.1" />
    <PackageVersion Include="Jcs.Net" Version="0.1.1" />
    <!-- AiDeck prompt templates. 5.12.1 tripped NuGetAudit-as-error (critical
         GHSA-5wr9-m6jw-xx44, vulnerable < 7.0.0); 7.5.3 = latest stable, patched.
         Rendering stays sandboxed (see PromptRenderer): templates are data. -->
    <PackageVersion Include="Scriban" Version="7.5.3" />
  </ItemGroup>
</Project>