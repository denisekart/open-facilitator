# syntax=docker/dockerfile:1
# Source-built Node runtime image: gateway, linkd and the deterministic worker
# share one dependency closure (the worker depends on @ofac/adapter,
# @ofac/gateway, @ofac/protocol, @ofac/workspace-link at runtime), so one image
# carries three self-contained app dirs. Consumers pick a process via command
# override — see reference/ compose files.

FROM node:22-bookworm AS build
WORKDIR /repo
RUN corepack enable
# Manifest layer first: installs only need the workspace topology.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY src/protocol/package.json src/protocol/
COPY src/workspace-link/package.json src/workspace-link/
COPY src/gateway/package.json src/gateway/
COPY src/adapters/harnesses/adapter-sdk/package.json src/adapters/harnesses/adapter-sdk/
COPY src/adapters/harnesses/deterministic/package.json src/adapters/harnesses/deterministic/
COPY src/adapters/provider-core/package.json src/adapters/provider-core/
COPY src/adapters/communication/mattermost/package.json src/adapters/communication/mattermost/
COPY src/adapters/communication/telegram/package.json src/adapters/communication/telegram/
COPY src/adapters/communication/forgejo/package.json src/adapters/communication/forgejo/
COPY src/adapters/communication/forgejo-connector/package.json src/adapters/communication/forgejo-connector/
COPY src/adapters/communication/github/package.json src/adapters/communication/github/
COPY src/adapters/communication/github-connector/package.json src/adapters/communication/github-connector/
COPY src/adapters/communication/gitlab/package.json src/adapters/communication/gitlab/
COPY src/adapters/communication/gitlab-connector/package.json src/adapters/communication/gitlab-connector/
COPY src/adapters/provisioning-oci/package.json src/adapters/provisioning-oci/
COPY examples/full/coding-worker/package.json examples/full/coding-worker/
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json ./
COPY src/protocol/ src/protocol/
COPY src/workspace-link/ src/workspace-link/
COPY src/gateway/ src/gateway/
COPY src/adapters/harnesses/adapter-sdk/ src/adapters/harnesses/adapter-sdk/
COPY src/adapters/harnesses/deterministic/ src/adapters/harnesses/deterministic/
COPY src/adapters/provider-core/ src/adapters/provider-core/
COPY src/adapters/communication/mattermost/ src/adapters/communication/mattermost/
COPY src/adapters/communication/telegram/ src/adapters/communication/telegram/
COPY src/adapters/communication/forgejo/ src/adapters/communication/forgejo/
COPY src/adapters/communication/forgejo-connector/ src/adapters/communication/forgejo-connector/
COPY src/adapters/communication/github/ src/adapters/communication/github/
COPY src/adapters/communication/github-connector/ src/adapters/communication/github-connector/
COPY src/adapters/communication/gitlab/ src/adapters/communication/gitlab/
COPY src/adapters/communication/gitlab-connector/ src/adapters/communication/gitlab-connector/
COPY src/adapters/provisioning-oci/ src/adapters/provisioning-oci/
COPY examples/full/coding-worker/ examples/full/coding-worker/
RUN pnpm -r build
# --prod + injected workspace deps: each dir is a runnable closure (node_modules
# with the workspace packages copied in), freshly built dist/ included via each
# package's `files: ["dist"]`.
RUN pnpm deploy --filter=@ofac/gateway --prod /deploy/gateway \
 && pnpm deploy --filter=@ofac/workspace-link --prod /deploy/linkd \
 && pnpm deploy --filter=@ofac/harness-deterministic --prod /deploy/worker \
 && pnpm deploy --filter=@ofac/mattermost-adapter --prod /deploy/mattermost-adapter \
 && pnpm deploy --filter=@ofac/telegram-adapter --prod /deploy/telegram-adapter \
 && pnpm deploy --filter=@ofac/forgejo-adapter --prod /deploy/forgejo-adapter \
 && pnpm deploy --filter=@ofac/forgejo-connector --prod /deploy/forgejo-connector \
 && pnpm deploy --filter=@ofac/provisioning-oci --prod /deploy/provisioning-oci \
 && pnpm deploy --filter=@ofac/example-coding-worker --prod /deploy/coding-worker

# Debian slim, not Alpine: better-sqlite3 ships glibc prebuilds (see
# pnpm-workspace.yaml allowBuilds); Alpine would force a node-gyp rebuild.
FROM node:22-bookworm-slim AS runtime
# AGPL-3.0-or-later (commercial dual-license available); ships with the image
# per the license's notice obligations.
COPY LICENSE /licenses/LICENSE
LABEL org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.vendor="Link Three Labs, d.o.o."
# git: the coding worker's clone/commit/push lane spawns it (git-minimal on
# bookworm ≈ +20MB; image size is irrelevant next to correctness).
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=build /deploy /app
# Writable state root for mounted consumers (compose demo-workspace: the
# Gateway stateDir, worker workDir, and supervisor logs live under here) +
# the bot-token handoff dir (Plan 22: named volume mounted at /provision,
# pre-creating it node-owned so the volume inherits that ownership).
RUN install -d -o node -g node /var/lib/ofac /provision
USER node
# Default process: the Gateway. linkd: `node /app/linkd/dist/bin/linkd.js run …`;
# worker: `node /app/worker/dist/bin/worker.js run …` (Plan 18 compose services);
# provider adapter: `node /app/mattermost-adapter/dist/bin/adapter.js run`
# (Plan 22). No EXPOSE: every process dials out to the kernel; the adapter's
# /healthz is probed via the published compose port, not an image contract.
# oci launcher: `node /app/provisioning-oci/dist/bin/launcher.js run --config …`
# (Plan 35 Phase C) — needs the docker socket mounted at the DOCKER_HOST path.
CMD ["node", "/app/gateway/dist/bin/gateway.js", "run"]
