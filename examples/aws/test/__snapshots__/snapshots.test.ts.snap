exports[`golden snapshots > ofac-example-observability 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ObservabilityAlarms72EB291A": {
      "Properties": {
        "DisplayName": "ofac kernel alarms",
        "Tags": [
          {
            "Key": "ofac:env",
            "Value": "example",
          },
          {
            "Key": "ofac:role",
            "Value": "platform",
          },
        ],
      },
      "Type": "AWS::SNS::Topic",
    },
    "ObservabilityAlb5xx8F5E973A": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarms72EB291A",
          },
        ],
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 2,
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::ImportValue": "ofac-example-kernel:ExportsOutputRefWebFaceAlb371BA2D271670875",
            },
          },
        ],
        "EvaluationPeriods": 2,
        "MetricName": "HTTPCode_Target_5XX_Count",
        "Namespace": "AWS/ApplicationELB",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "ofac:env",
            "Value": "example",
          },
          {
            "Key": "ofac:role",
            "Value": "platform",
          },
        ],
        "Threshold": 25,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityDeadLettersD587CF1C": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarms72EB291A",
          },
        ],
        "ComparisonOperator": "GreaterThanThreshold",
        "DatapointsToAlarm": 2,
        "EvaluationPeriods": 2,
        "MetricName": "facilitator.outbox.dead_letters",
        "Namespace": "facilitator",
