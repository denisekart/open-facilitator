{
  "name": "example",
  "topology": "tailscale",
  "kernel": {
    "host": "kernel.tailnet-abc123.ts.net",
    "ports": { "kernel": 7488, "idp": 7480, "aspireUi": 7490 },
    "teams": ["home"],
    "enrollmentTtlMinutes": 60
  },
  "nodes": [
    { "host": "pc1.tailnet-abc123.ts.net", "gatewayId": "gw.pc1", "teams": ["home"], "launcher": true },
    { "host": "pc2.tailnet-abc123.ts.net", "gatewayId": "gw.pc2", "teams": ["home"], "launcher": true }
  ],
  "images": { "kernel": "local", "node": "local", "worker": "local" },
  "tls": "internal",
  "tailscale": { "keyEnv": "TS_AUTHKEY", "funnel": true },
  "backupPath": "/var/backups/facilitator",
  "secretsFile": "secrets/example.env",
  "externals": {
    "github": { "webhookPath": "/api/ingress/webhooks/github", "secretEnv": "GITHUB_WEBHOOK_SECRET" },
    "mattermost": { "url": "https://mm.tailnet-abc123.ts.net", "botTokenEnv": "MATTERMOST_BOT_TOKEN" }
  },
  "sshUser": "facilitator",
  "remoteDir": "/opt/facilitator"
}
