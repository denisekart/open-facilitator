{
  "id": "facilitator",
  "realm": "facilitator",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "framework-admin",
        "description": "Role-rule management authority (and the enrollment-token mint gate)."
      },
      {
        "name": "kernel-operator",
        "description": "Work-plane write authority (POST /api/works, steer, transitions)."
      },
      {
        "name": "gateway-workload",
        "description": "Gateway workload identity: polls its own work's approvals."
      }
    ]
  },
  "groups": [
    {
      "name": "teams",
      "path": "/teams",
      "subGroups": [__TEAM_SUBGROUPS__]
    }
  ],
  "clients": [
    {
      "clientId": "facilitator-api",
      "name": "Facilitator kernel audience (SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [__API_REDIRECTS__],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "claim.name": "groups"
          }
        },
        {
          "name": "audience-completor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "facilitator-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "facilitator-cli",
      "name": "Kernel CLI / automation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__CLI_SECRET__",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "claim.name": "groups"
          }
        },
        {
          "name": "audience-completor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "facilitator-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Home",
      "lastName": "Admin",
      "email": "admin@home.local",
      "emailVerified": true,
      "realmRoles": ["default-roles-facilitator", "framework-admin", "kernel-operator"],
      "groups": [__ADMIN_GROUPS__],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "disableableCredentialTypes": ["password"]
    },
    {
      "username": "service-account-facilitator-cli",
      "enabled": true,
      "realmRoles": ["default-roles-facilitator", "kernel-operator", "framework-admin"],
      "requiredActions": [],
      "serviceAccountClientId": "facilitator-cli"
    }
  ]
}
