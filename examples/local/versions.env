# Pinned third-party image versions for the local example (mirrors
# reference/versions.env — same update law: PR + a compose verification run).
# The framework images (facilitator, node-runtime, elastic worker) are NOT
# pinned here: the roles file's `images:` block decides per env whether they
# are built locally from the repo or pulled as `name@sha256:…` digests.
POSTGRES_TAG=17-alpine
KEYCLOAK_TAG=26.7.5
SEAWEEDFS_TAG=4.48                         # chrislusf/seaweedfs — weed mini serves S3 + pre-creates the bucket (reference/'s service line; MinIO's Docker Hub repos were removed Sep 2026)
AWSCLI_TAG=2.39.0                          # amazon/aws-cli — backup mirrors ride it (mc's Docker Hub repos are gone too)
ASPIRE_TAG=13.4.2                        # mcr.microsoft.com/dotnet/aspire-dashboard (13.x ASPIRE_* env contract)
CADDY_TAG=2.10-alpine
TAILSCALE_TAG=v1.90.6
# Release-time digest pins (filled by the release job, not by hand — an empty
# field keeps the :tag form working, same idiom as reference/versions.env):
POSTGRES_DIGEST=
KEYCLOAK_DIGEST=
SEAWEEDFS_DIGEST=
ASPIRE_DIGEST=
CADDY_DIGEST=
TAILSCALE_DIGEST=
