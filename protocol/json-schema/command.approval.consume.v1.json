{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/command.approval.consume.v1.json",
  "title": "ApprovalConsumeCommandV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "approvalId",
    "actorEvidenceRef"
  ],
  "properties": {
    "commandId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "approvalId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "actorEvidenceRef": {
      "$ref": "common.v1.json#/$defs/evidenceRef",
      "description": "The consuming workload's own evidence ref (e.g. workload:<gatewayId>); the kernel authorizes on the caller endpoint owning the approval, not on this claim."
    },
    "comment": {
      "type": "string",
      "maxLength": 1024
    }
  }
}
