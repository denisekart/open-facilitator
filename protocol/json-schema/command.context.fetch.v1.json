{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/command.context.fetch.v1.json",
  "title": "ContextFetchCommandV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "workId",
    "targetId",
    "actorEvidenceRef",
    "deadline",
    "contextRefs"
  ],
  "properties": {
    "commandId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "workId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "targetId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "actorEvidenceRef": {
      "$ref": "common.v1.json#/$defs/evidenceRef"
    },
    "deadline": {
      "$ref": "common.v1.json#/$defs/rfc3339DateTime"
    },
    "contextRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
