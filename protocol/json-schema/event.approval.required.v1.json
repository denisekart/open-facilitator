{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/event.approval.required.v1.json",
  "title": "ApprovalRequiredEventV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalId",
    "actionDigest",
    "eligibleActors",
    "nonce",
    "expiresAt",
    "createdAt"
  ],
  "properties": {
    "approvalId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "actionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligibleActors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.v1.json#/$defs/idToken"
      }
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "expiresAt": {
      "$ref": "common.v1.json#/$defs/rfc3339DateTime"
    },
    "createdAt": {
      "$ref": "common.v1.json#/$defs/rfc3339DateTime"
    }
  }
}
