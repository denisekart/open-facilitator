{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/event.artifact.available.v1.json",
  "title": "ArtifactAvailableEventV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "mediaType",
    "size",
    "digest"
  ],
  "properties": {
    "artifactId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storageUrl": {
      "type": "string",
      "format": "uri"
    },
    "createdBy": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "createdAt": {
      "$ref": "common.v1.json#/$defs/rfc3339DateTime"
    },
    "workId": {
      "$ref": "common.v1.json#/$defs/idToken"
    }
  }
}
