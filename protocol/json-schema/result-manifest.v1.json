{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/result-manifest.v1.json",
  "title": "ResultManifestV1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifestId",
    "outputs"
  ],
  "properties": {
    "manifestId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "common.v1.json#/$defs/artifactRef"
      }
    },
    "revisionOf": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    },
    "workId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "assignmentId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "capability": {
      "type": "string",
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "structuredResult": {
      "type": "object"
    },
    "externalRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 256
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
