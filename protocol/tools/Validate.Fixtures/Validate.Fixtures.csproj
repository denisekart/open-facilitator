<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spec §26.1 item 1's .NET conformance harness: validates every fixture in
       protocol/conformance-fixtures against the shipped schemas; the kernel
       inbox reuses it as its fixture source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ofac.Protocol.ValidateFixtures</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Jcs.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../dotnet/Ofac.Protocol/Ofac.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the kernel's digest helper directly (source): the golden must
         exercise the production implementation, and a ProjectReference to the
         web app drags EF Core version conflicts into this harness. -->
    <Compile Include="../../../src/facilitator/Kernel/Shared/ApprovalDigest.cs" />
  </ItemGroup>
</Project>
