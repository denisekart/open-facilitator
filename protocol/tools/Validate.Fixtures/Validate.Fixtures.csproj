       protocol/conformance-fixtures against the shipped schemas. Plan 02 reuses
       this as its inbox fixture source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ofac.Protocol.ValidateFixtures</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Jcs.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../dotnet/Ofac.Protocol/Ofac.Protocol.csproj" />
  </ItemGroup>
</Project>
