# Local secrets for the reference environment (copy to .env; never commit .env).
# Every key names its consumer; compose files reference these verbatim.

# Postgres superuser password — consumer: reference Postgres container + Facilitator connection string
DEMO_POSTGRES_PASSWORD=change-me-postgres

# Keycloak admin password — consumer: reference Keycloak container + bootstrap realm import
DEMO_KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# S3 access key — consumer: SeaweedFS S3 gateway (artifact storage, spec §15)
DEMO_S3_ACCESS_KEY=changeme-s3-access

# S3 secret key — consumer: SeaweedFS S3 gateway (artifact storage, spec §15)
DEMO_S3_SECRET_KEY=change-me-s3-secret

# Link enrollment token (mode (a)) — consumer: Facilitator kernel Link enrollment (POST /api/link/v1/enroll mode (a))
DEMO_ENROLLMENT_TOKEN=change-me-enrollment-token
