# The facilitator's full environment — the ONE source both the primary and
# the replica twin (compose.replicas.yaml, via `extends`) read, so a replica
# can never drift from its primary. Interpolated by compose against
# versions.env + .env, same as an inline environment: block.
#
# Otel:Endpoint is the kernel's on/off switch; the exporter transport
# reads the standard OTLP env vars (AddOtlpExporter takes no argument).
# The .NET exporter defaults to gRPC (dashboard :18889); pin HTTP so both
# point at the dashboard's HTTP/protobuf listener :18890.
#
# The provisioning block arms the scale law: NetworkMode is the compose
# project's default network (pre-created by the facilitator's own dependency
# chain before any container launches). The $-prefixed env VALUES are the
# launcher's expansion contract: secrets travel by NAME, resolved from the
# launcher's own env.
# The kill-9 continuity leg's timing law: a 5s heartbeat (the SDK adopts the
# welcome's advertised value) pins the session lease at 15s, so the
# session-loss sweeper's two passes (5s each) fail a dead gateway's execution
# ~25s after the kill — far inside the leg's 90s window. Without it the
# default 30s heartbeat leases 90s and the leg races the lease.
ConnectionStrings__Facilitator=Host=postgres;Database=facilitator;Username=demo;Password=${DEMO_POSTGRES_PASSWORD:?set in .env}
Link__EnrollmentToken=${DEMO_ENROLLMENT_TOKEN:?set in .env}
Link__HeartbeatSeconds=5
Storage__Provider=s3
Storage__S3__Endpoint=http://artifacts:8333
Storage__S3__Bucket=facilitator-artifacts
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=${DEMO_S3_ACCESS_KEY:?set in .env}
Storage__S3__SecretKey=${DEMO_S3_SECRET_KEY:?set in .env}
Otel__Endpoint=http://aspire:18890
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire:18890
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=facilitator
Provision__LauncherEndpoint=oci-launcher
Provision__SweepIntervalSeconds=10
Provision__Workloads__0__WorkloadId=gw.team-beta
Provision__Workloads__0__Team=team-beta
Provision__Workloads__0__Image=${OCI_REGISTRY:?set in versions.env}/elastic-worker:${FRAMEWORK_TAG:?set in versions.env}
Provision__Workloads__0__Network=facilitator-demo_default
Provision__Workloads__0__Entrypoint__0=/bin/sh
Provision__Workloads__0__Entrypoint__1=/opt/ofac/ofac-supervisor.sh
Provision__Workloads__0__Env__UNITS_DIR=/opt/ofac/units
Provision__Workloads__0__Env__OFAC_LOG_DIR=/var/lib/ofac/logs
Provision__Workloads__0__Env__OFAC_KERNEL_URL=http://facilitator:8080
Provision__Workloads__0__Env__OFAC_WORKER_TEAM=team-beta
Provision__Workloads__0__Env__OFAC_WORKER_ENDPOINT=elastic-worker-child
Provision__Workloads__0__Env__OFAC_ENROLL_SECRET=$$DEMO_ENROLLMENT_TOKEN
Provision__Workloads__0__Env__OFAC_CHILD_SECRET=$$DEMO_CHILD_SECRET
# A dead unit must surface as an exited container (the launcher's relaunch
# law), not a supervisor restart loop.
Provision__Workloads__0__Env__OFAC_SUPERVISOR_MAX_RESTARTS=3
Provision__Workloads__0__Labels__io.facilitator.managed=kernel-provisioned
