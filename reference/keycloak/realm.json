{
  "id": "facilitator",
  "realm": "facilitator",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "framework-admin",
        "description": "Role-rule management authority."
      },
      {
        "name": "kernel-operator",
        "description": "Work-plane write authority (POST /api/works, steer, transitions)."
      },
      {
        "name": "e2e-operator",
        "description": "Realm role the e2e/dev CLI service account holds; role-rule config maps it to the kernel-operator role."
      }
    ]
  },
  "groups": [
    {
      "name": "teams",
      "path": "/teams",
      "subGroups": [
        {
          "name": "team-alpha",
          "path": "/teams/team-alpha",
          "subGroups": []
        },
        {
          "name": "team-beta",
          "path": "/teams/team-beta",
          "subGroups": []
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "facilitator-api",
      "name": "Facilitator kernel audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-completor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "facilitator-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "facilitator-cli",
      "name": "Kernel CLI / automation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "e2e-cli-secret",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-completor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "facilitator-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "realmRoles": [
        "default-roles-facilitator",
        "framework-admin"
      ],
      "groups": [
        "/teams/team-alpha"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "disableableCredentialTypes": [
        "password"
      ],
      "lastName": "Anderson",
      "email": "alice@example.test",
      "emailVerified": true
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "realmRoles": [
        "default-roles-facilitator"
      ],
      "groups": [
        "/teams/team-beta"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "disableableCredentialTypes": [
        "password"
      ],
      "lastName": "Brown",
      "email": "bob@example.test",
      "emailVerified": true
    },
    {
      "username": "carol",
      "enabled": true,
      "firstName": "Carol",
      "realmRoles": [
        "default-roles-facilitator"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "carol",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "disableableCredentialTypes": [
        "password"
      ],
      "lastName": "Cartwright",
      "email": "carol@example.test",
      "emailVerified": true
    },
    {
      "username": "service-account-facilitator-cli",
      "enabled": true,
      "realmRoles": [
        "default-roles-facilitator",
        "kernel-operator",
        "e2e-operator"
      ],
      "requiredActions": [],
      "serviceAccountClientId": "facilitator-cli"
    }
  ]
}
