# Pinned reference image versions (spec §22.4). Update via PR with a compose verification run.
POSTGRES_TAG=17-alpine
KEYCLOAK_TAG=26.7.5
KAFKA_TAG=4.2.2
FORGEJO_TAG=16.0.7          # spec pins the 16.x family (16.0.2's blobs were GC'd upstream — first pull 404s); v17 untested for us
MATTERMOST_TAG=11.11.1      # exact docker tag format verified by the compose bring-up
SEAWEEDFS_TAG=4.48
ASPIRE_TAG=13.4.2           # mcr.microsoft.com/dotnet/aspire-dashboard (13.x ASPIRE_* env contract)
OLLAMA_TAG=0.40.9
# AWS CLI v2 image — tooling for the CI artifact-bucket assertion, not a service
AWSCLI_TAG=2.39.0
# Registry for framework-built images (facilitator, node-runtime, features, examples):
OCI_REGISTRY=ghcr.io/denisekart/open-facilitator
# Tag for source-built framework images (facilitator, node-runtime) until
# release digests land; compose interpolates it verbatim.
FRAMEWORK_TAG=dev
# Release-time digest pins (filled by the release job, not by hand):
POSTGRES_DIGEST=
KEYCLOAK_DIGEST=
KAFKA_DIGEST=
FORGEJO_DIGEST=
MATTERMOST_DIGEST=
SEAWEEDFS_DIGEST=
ASPIRE_DIGEST=
OLLAMA_DIGEST=
FACILITATOR_DIGEST=
