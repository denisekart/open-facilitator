{
  "name": "@ofac/adapter",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisekart/open-facilitator.git",
    "directory": "src/adapters/harnesses/adapter-sdk"
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts --format esm --dts --target node22 --silent",
    "test": "vitest run",
    "test:e2e": "vitest run --passWithNoTests --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@ofac/gateway": "workspace:*",
    "@ofac/protocol": "workspace:*",
    "@ofac/workspace-link": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
