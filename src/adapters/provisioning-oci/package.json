{
  "name": "@ofac/provisioning-oci",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "oci-launcher": "./dist/bin/launcher.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisekart/open-facilitator.git",
    "directory": "src/adapters/provisioning-oci"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/launcher.ts --format esm --dts --target node22 --silent",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ofac/protocol": "workspace:*",
    "@ofac/workspace-link": "workspace:*",
    "better-sqlite3": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
