{
  "name": "@ofac/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ofac-gateway": "./dist/bin/gateway.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisekart/open-facilitator.git",
    "directory": "src/gateway"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/gateway.ts --format esm --dts --target node22 --silent",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@ofac/protocol": "workspace:*",
    "@ofac/workspace-link": "workspace:*",
    "better-sqlite3": "catalog:",
    "jose": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
