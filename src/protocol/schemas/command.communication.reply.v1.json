{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/command.communication.reply.v1.json",
  "title": "CommunicationReplyCommandV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["commandId", "target", "text", "idempotencyKey"],
  "properties": {
    "commandId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "target": {
      "$ref": "common.v1.json#/$defs/conversationTarget"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "idempotencyKey": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "common.v1.json#/$defs/artifactRef"
      },
      "description": "Outbound media the adapter should post alongside the reply text (the kernel emits these for harness-produced artifacts; the adapter consumes them)."
    }
  }
}
