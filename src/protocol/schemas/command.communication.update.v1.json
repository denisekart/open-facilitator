{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/command.communication.update.v1.json",
  "title": "CommunicationUpdateCommandV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["commandId", "target", "text", "idempotencyKey"],
  "properties": {
    "commandId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "target": {
      "$ref": "common.v1.json#/$defs/conversationTarget"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "idempotencyKey": {
      "$ref": "common.v1.json#/$defs/idToken"
    }
  }
}
