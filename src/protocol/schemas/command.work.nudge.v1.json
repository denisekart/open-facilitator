{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/command.work.nudge.v1.json",
  "title": "WorkNudgeCommandV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "workId",
    "targetId",
    "actorEvidenceRef",
    "deadline",
    "assignmentId",
    "executionGeneration"
  ],
  "properties": {
    "commandId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "workId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "targetId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "actorEvidenceRef": {
      "$ref": "common.v1.json#/$defs/evidenceRef"
    },
    "deadline": {
      "$ref": "common.v1.json#/$defs/rfc3339DateTime"
    },
    "assignmentId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "stallEpisode": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "executionGeneration": {
      "type": "integer",
      "minimum": 1
    }
  }
}
