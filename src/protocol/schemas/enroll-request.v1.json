{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/enroll-request.v1.json",
  "title": "EnrollRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token",
    "endpointId",
    "instanceId",
    "trustMode"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "endpointId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "instanceId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "trustMode": {
      "type": "string",
      "enum": [
        "shared-runtime",
        "separate-process-same-host",
        "isolated-executor"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "gateway",
        "child"
      ]
    },
    "team": {
      "$ref": "common.v1.json#/$defs/idToken"
    }
  }
}
