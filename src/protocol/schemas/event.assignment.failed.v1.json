{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/event.assignment.failed.v1.json",
  "title": "AssignmentFailedEventV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workId",
    "assignmentId",
    "executionGeneration",
    "reason",
    "retryable"
  ],
  "properties": {
    "workId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "assignmentId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "executionId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "executionGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
