{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/event.context.fetched.v1.json",
  "title": "ContextFetchedEventV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["fetchId", "workId", "responder", "items"],
  "properties": {
    "fetchId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "workId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "responder": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "content", "truncated"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "content": {
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    },
    "deadline": {
      "$ref": "common.v1.json#/$defs/rfc3339DateTime"
    },
    "note": {
      "type": "string",
      "maxLength": 512
    }
  }
}
