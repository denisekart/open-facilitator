{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/event.provider.forgejo.ci.v1.json",
  "title": "ProviderForgejoCiEventV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference",
    "providerDeliveryId",
    "actorProviderAccountId",
    "action"
  ],
  "properties": {
    "reference": {
      "$ref": "common.v1.json#/$defs/conversationReference"
    },
    "providerDeliveryId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "actorProviderAccountId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "action": {
      "type": "string",
      "enum": ["pending", "success", "failure", "error"],
      "description": "Commit-status state (Forgejo `status` webhook event)."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "Commit-status description verbatim."
    },
    "payload": {
      "type": "object",
      "description": "Verbatim provider event payload as received by the adapter.",
      "additionalProperties": true
    }
  }
}
