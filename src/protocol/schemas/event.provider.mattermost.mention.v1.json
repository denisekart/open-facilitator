{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openfacilitator.org/v1/event.provider.mattermost.mention.v1.json",
  "title": "ProviderMattermostMentionEventV1Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference",
    "providerDeliveryId",
    "actorProviderAccountId",
    "text"
  ],
  "properties": {
    "reference": {
      "$ref": "common.v1.json#/$defs/conversationReference"
    },
    "providerDeliveryId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "actorProviderAccountId": {
      "$ref": "common.v1.json#/$defs/idToken"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "payload": {
      "type": "object",
      "description": "Verbatim provider event payload as received by the adapter.",
      "additionalProperties": true
    }
  }
}
